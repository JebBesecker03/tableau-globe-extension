<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.lifesciences.extensions.globe3d" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Interactive 3D globe that draws lat/long data as bars rising from the Earth's surface.</description>
    <author name="Jeb Besecker" email="jbeseckersf@gmail.com" organization="Life Sciences" website="https://www.tableau.com"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>http://localhost:8765/index.html</url>
    </source-location>
    <icon></icon>
    <encoding id="latitude">
      <display-name resource-id="enc-latitude">Latitude</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-y"/>
    </encoding>
    <encoding id="longitude">
      <display-name resource-id="enc-longitude">Longitude</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-x"/>
    </encoding>
    <encoding id="height">
      <display-name resource-id="enc-height">Height</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="size"/>
    </encoding>
    <encoding id="color">
      <display-name resource-id="enc-color">Color</display-name>
      <fields max-count="1"/>
      <encoding-icon token="color"/>
    </encoding>
    <!-- Tableau allows at most 4 custom encodings; Detail and Tooltip are always on the Marks card. -->
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">3D Globe</text>
    </resource>
    <resource id="enc-latitude">
      <text locale="en_US">Latitude</text>
    </resource>
    <resource id="enc-longitude">
      <text locale="en_US">Longitude</text>
    </resource>
    <resource id="enc-height">
      <text locale="en_US">Height</text>
    </resource>
    <resource id="enc-color">
      <text locale="en_US">Color</text>
    </resource>
  </resources>
</manifest>
