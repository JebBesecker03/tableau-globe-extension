{
  "name": "globe-viz",
  "private": true,
  "version": "0.1.0",
  "description": "3D globe Viz Extension for Tableau",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:places": "node scripts/build-places.mjs",
    "build:zips": "node scripts/build-zips.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "globe.gl": "^2.46.2",
    "three": "^0.186.1",
